RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule . /strum/index.html [L]

# Built files have a content hash in their name, so they never change: cache for a year.
# The page itself is always re-checked so new deploys show up straight away.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
